# PostgreSQL Database Configuration
# Copy this file to .env and update with your actual values

DB_HOST=localhost
DB_PORT=5432
DB_NAME=nwis_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and change DB_PASSWORD to your actual PostgreSQL password
# 3. The .env file will be ignored by git (security)
