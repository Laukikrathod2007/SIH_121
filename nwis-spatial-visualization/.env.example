# Generic same-origin API proxy. Set this to the chosen backend; no default/stale port is used.
SPATIAL_BACKEND_URL=
# Optional server-side credential for other backends; never prefix these with VITE_.
SPATIAL_API_AUTH_HEADER=X-API-Key
SPATIAL_API_AUTH_VALUE=
# SPATIAL_API_KEY is a convenience alias for X-API-Key authentication.
SPATIAL_API_KEY=

# Legacy Module 02 configuration remains supported; SPATIAL_* takes precedence.
NWIS_BACKEND_URL=
# Default preview uses the bundled Volve surveys. Set this to `nwis` when SPATIAL_BACKEND_URL is configured.
VITE_VISUALIZATION_PROVIDER=
# Optional Google Maps Platform photorealistic 3D Tiles key. This is a browser key, not a secret:
# restrict HTTP referrers to your app origins and restrict the key to Map Tiles API.
VITE_GOOGLE_MAPS_3D_KEY=
# Optional Cesium ion public token for global elevation terrain; restrict its allowed origins/assets.
VITE_CESIUM_ION_TOKEN=
# Keep this unprefixed. It is read by the Vite server proxy and never bundled into browser JavaScript.
NWIS_API_KEY='replace-with-your-server-side-key'
# Set only to an observed/confirmed measured depth when running telemetry/DORS diagnostics.
NWIS_TELEMETRY_MD=
