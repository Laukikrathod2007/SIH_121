# NWIS Unified Backend configuration. Copy this file to .env and fill in
# real values. .env is git-ignored -- never commit a real key.

NWIS_API_KEY=

# PostgreSQL (database/docker-compose.yml) -- enables the DB-backed well/
# trajectory/formations/casing/document paths (Pass 4). Leave unset to run
# entirely on the in-memory/SQLite/JSON stores (pre-Pass-4 behavior).
# NWIS_DATABASE_URL=postgresql://nwis:nwis_dev_password@localhost:5433/nwis

# Optional tuning (defaults shown):
# NWIS_ENV=dev                              # set to "production" for a hard
#                                            # startup failure if NWIS_API_KEY
#                                            # is unset (no silent insecure default)
# NWIS_HOST=0.0.0.0
# NWIS_PORT=8000
# NWIS_CORS_ORIGINS=                         # extra allowed origins, comma-separated
# NWIS_RATE_LIMIT_ENABLED=true
# NWIS_RATE_LIMIT_INGEST_MAX_REQUESTS=20     # M01 document upload (was module-specific)
# NWIS_RATE_LIMIT_GENERAL_MAX_REQUESTS=60    # M01 read routes, M02 well/geospatial routes
# NWIS_RATE_LIMIT_PHYSICS_MAX_REQUESTS=600   # M04/M05 -- legitimately high-frequency polling
