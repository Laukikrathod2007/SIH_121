# NWIS Unified Backend configuration — the ONE .env file for the entire
# backend (document intelligence, well/geospatial intelligence, physics
# digital twin, predictive analytics, evidence delivery all read this one
# file via Backend/app/core/config.py). Copy this file to .env and fill in
# real values. .env is git-ignored — never commit a real key.
#
# There is no separate .env per module. If you see a modules/*/.env file,
# it is stale — delete it; nothing in the active serving path reads it.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Required to run with auth enabled (recommended always, required in
# production — see NWIS_ENV below). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank only for local dev with auth disabled.
NWIS_API_KEY=

# "dev" (default) or "production". In production, the app refuses to start
# if NWIS_API_KEY is unset — no silent insecure default.
NWIS_ENV=dev

# Host/port the server listens on.
#   Local dev: defaults below are fine.
#   Render (or any platform that injects its own PORT): Render sets its own
#   PORT env var and expects the app to listen on it. Set NWIS_PORT to the
#   same value as Render's PORT (Render exposes $PORT to your service; the
#   simplest approach is to set NWIS_PORT=$PORT in Render's own environment
#   settings, or see the deployment guide for the one-line run.py change
#   that reads $PORT automatically).
NWIS_HOST=0.0.0.0
NWIS_PORT=8000

# Comma-separated list of additional allowed CORS origins, beyond the
# built-in localhost dev defaults (localhost:5173, localhost:3000,
# 127.0.0.1:5173). Add your deployed frontend's origin here, e.g.
#   NWIS_CORS_ORIGINS=https://your-app.vercel.app
NWIS_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Database — PostgreSQL/PostGIS/pgvector (database/schema.sql)
# ---------------------------------------------------------------------------
# Enables the DB-backed well/trajectory/formations/casing/events/alerts/
# document paths and makes PostgreSQL the shared source of truth for those
# domains. Leave BOTH of the following unset to run entirely on the
# in-memory/JSON testbed stores (no database required — fine for a quick
# local look, not recommended for anything you want to persist or demo
# from multiple sessions).
#
# Option 1 — one full connection string (preferred; this is what a managed
# Postgres host like Render gives you directly as "Internal Database URL"):
# NWIS_DATABASE_URL=postgresql://nwis:nwis_dev_password@localhost:5433/nwis
#
# Option 2 — discrete fields, assembled into a DSN automatically if
# NWIS_DATABASE_URL is not set (useful if your host gives you separate
# host/port/user/password/dbname fields instead of one URL string):
# NWIS_DB_HOST=
# NWIS_DB_PORT=5433
# NWIS_DB_NAME=nwis
# NWIS_DB_USER=nwis
# NWIS_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Document intelligence — optional Tier 2 cloud OCR fallback
# ---------------------------------------------------------------------------
# Used only for pages below the local extraction confidence threshold.
# Leave both keys blank to disable (local-only extraction, no outbound
# calls, no cost). See modules/01_document_intelligence/pipeline/cloud_fallback.py.
NWIS_CLOUD_FALLBACK_ENABLED=true
NWIS_REDUCTO_API_KEY=
NWIS_EXTEND_API_KEY=
NWIS_EXTEND_WORKSPACE_ID=
# NWIS_CLOUD_FALLBACK_CONFIDENCE_THRESHOLD=0.75
# NWIS_CLOUD_FALLBACK_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Document intelligence — formation-name vocabulary
# ---------------------------------------------------------------------------
# Which basin's formation-name list the entity extractor and validators use.
# Defaults to the project's existing Upper Assam / Arakan vocabulary; only
# change this if you are pointing the pipeline at documents from a
# different basin and have a matching profile defined in
# modules/01_document_intelligence/models/domain_rules.py.
# NWIS_FORMATION_PROFILE=ASSAM_ARAKAN

# ---------------------------------------------------------------------------
# Rate limiting (per-category, all enabled by default)
# ---------------------------------------------------------------------------
# NWIS_RATE_LIMIT_ENABLED=true
# NWIS_RATE_LIMIT_INGEST_MAX_REQUESTS=20     # document upload (modules/01)
# NWIS_RATE_LIMIT_GENERAL_MAX_REQUESTS=60    # well/geospatial/knowledge routes (modules/01 reads, modules/02)
# NWIS_RATE_LIMIT_PHYSICS_MAX_REQUESTS=600   # physics/predictive routes — legitimately high-frequency polling
# NWIS_RATE_LIMIT_AGENT_MAX_REQUESTS=10      # Knowledge Copilot chat turns — each is a real LLM call, several seconds

# ---------------------------------------------------------------------------
# Agentic Knowledge Copilot — local LLM via Ollama (free, no API key)
# ---------------------------------------------------------------------------
# Requires Ollama (https://ollama.com) running locally with the model
# pulled: `ollama pull qwen2.5:7b-instruct`. If Ollama is unreachable at
# request time, the Copilot honestly falls back to keyword search instead
# of failing — see frontend/src/pages/CopilotPage.tsx. NOT available on
# Render's free tier (no persistent compute for a multi-GB local model) —
# see AUDIT/16_DEPLOYMENT_GUIDE.md.
# NWIS_OLLAMA_URL=http://localhost:11434
# NWIS_OLLAMA_MODEL=qwen2.5:7b-instruct
