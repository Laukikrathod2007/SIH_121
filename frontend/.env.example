# Copy this file to .env — every value below has a working default if you
# leave it unset. .env is git-ignored — never commit a real key.

# ONE unified backend (Backend/app/main.py) serves document intelligence
# (/api/v1), well/geospatial intelligence (/api/v2), physics digital twin +
# predictive analytics (/api/v3), and evidence/PDF delivery (/api/evidence)
# -- all on this one origin. Default matches Backend/run.py's default port.
VITE_API_BASE=http://localhost:8000

# Must match NWIS_API_KEY in Backend/.env. Leave blank if the backend is
# running with auth disabled (NWIS_API_KEY unset server-side).
VITE_API_KEY=

# Optional explicit overrides -- normally derived from VITE_API_BASE above,
# only set these if the physics WebSocket stream or evidence delivery are
# genuinely served from a DIFFERENT origin than the rest of the API (not
# the case in the standard one-backend deployment):
# VITE_TELEMETRY_WS_URL=ws://localhost:8000/api/v3/physics/stream
# VITE_EVIDENCE_SERVER=http://localhost:8000/api/evidence
