# Copy this file to .env — every value below has a working default if you
# leave it unset (matches modules/01_document_intelligence/.env.example and
# modules/02_nwis_backend/.env.example's pattern). .env is git-ignored —
# never commit real keys.

# --- Module 01: Document Intelligence (default http://localhost:8001) ---
VITE_M01_API_BASE=http://localhost:8001
# Must match NWIS_API_KEY in modules/01_document_intelligence/.env — leave
# blank if that module is running with auth disabled (no NWIS_API_KEY set).
VITE_M01_API_KEY=

# --- Module 02: NWIS Backend Intelligence (default http://localhost:8002) ---
VITE_M02_API_BASE=http://localhost:8002
# Must match NWIS_API_KEY in modules/02_nwis_backend/.env.
VITE_M02_API_KEY=

# --- Module 03: Physics Digital Twin — PLACEHOLDER, NOT YET WIRED ---
# modules/03_physics_engine/ has no FastAPI routes exposed yet (parallel
# effort, out of scope for this port). LiveDrillingPage, SimulatorPage, and
# parts of RiskPredictionPage/AlertsAdvisoryPage will fail to load live data
# until this module ships real HTTP/WS endpoints at this base URL.
VITE_M03_API_BASE=http://localhost:8003
VITE_M03_API_KEY=
