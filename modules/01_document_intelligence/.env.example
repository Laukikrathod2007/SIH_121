# Copy this file to .env and fill in the key(s) you have.
# .env is git-ignored — never commit real keys.
#
# Neither key is required — the cloud fallback (pipeline/cloud_fallback.py)
# stays fully inert until at least one is set. Reducto is tried first; Extend.ai
# is tried if Reducto's key is unset or its call fails.

NWIS_REDUCTO_API_KEY=
NWIS_EXTEND_API_KEY=
# Only needed if your Extend.ai key is workspace/org-scoped:
NWIS_EXTEND_WORKSPACE_ID=

# Optional tuning (defaults shown):
# NWIS_CLOUD_FALLBACK_ENABLED=true
# NWIS_CLOUD_FALLBACK_CONFIDENCE_THRESHOLD=0.75
# NWIS_CLOUD_FALLBACK_TIMEOUT_SECONDS=30

# Which basin's formation-name list to match against (models/domain_rules.py
# FORMATION_PROFILES). Added after real-data testing against Equinor's Volve
# field (North Sea) found the formation list was hardcoded to Assam-Arakon
# only — extract_formation_tops() builds its search patterns FROM this list,
# so an unrecognized basin silently extracts zero formation tops, not
# degraded ones. Default unchanged (ASSAM_ARAKAN) — existing deployments see
# no behavior change unless this is set.
# NWIS_FORMATION_PROFILE=ASSAM_ARAKAN
# NWIS_FORMATION_PROFILE=NORTH_SEA_VOLVE
