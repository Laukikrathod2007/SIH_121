# Copy this file to .env — or just run run_server.py, which auto-generates
# NWIS_API_KEY on first run if this file doesn't already set one.
# .env is git-ignored — never commit a real key.

NWIS_API_KEY=

# Optional tuning (defaults shown):
# NWIS_ENV=dev                              # set to "production" to disable auto-reload
# NWIS_HOST=0.0.0.0
# NWIS_PORT=8002
# NWIS_CORS_ORIGINS=                         # extra allowed origins, comma-separated
# NWIS_RATE_LIMIT_ENABLED=true
# NWIS_RATE_LIMIT_MAX_REQUESTS=60
# NWIS_RATE_LIMIT_WINDOW_SECONDS=60

# Phase 1 canonical database layer (db/) — optional. Unset = every endpoint
# behaves exactly as before this layer existed, served entirely by the
# in-memory NWISDataStore. Set either the full URL, or the individual
# NWIS_DB_* parts (matching database/docker-compose.yml's defaults):
# NWIS_DATABASE_URL=postgresql://nwis:nwis_dev_password@localhost:5433/nwis
# NWIS_DB_HOST=localhost
# NWIS_DB_PORT=5433
# NWIS_DB_NAME=nwis
# NWIS_DB_USER=nwis
# NWIS_DB_PASSWORD=nwis_dev_password
