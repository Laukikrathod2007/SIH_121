# Copy this file to .env — or just run run_server.py, which auto-generates
# NWIS_API_KEY on first run if this file doesn't already set one.
# .env is git-ignored — never commit a real key.

NWIS_API_KEY=

# Optional tuning (defaults shown):
# NWIS_ENV=dev                              # set to "production" to disable auto-reload
# NWIS_HOST=0.0.0.0
# NWIS_PORT=8003
# NWIS_CORS_ORIGINS=                         # extra allowed origins, comma-separated
# NWIS_RATE_LIMIT_ENABLED=true
# NWIS_RATE_LIMIT_MAX_REQUESTS=600
# NWIS_RATE_LIMIT_WINDOW_SECONDS=60
